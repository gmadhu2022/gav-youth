# Supabase → Project Settings → API Keys
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Publishable key (sb_publishable_...) — or legacy "anon" key. Low privilege.
SUPABASE_ANON_KEY=sb_publishable_xxx

# Secret key (sb_secret_...) — or legacy "service_role" key.
# Bypasses RLS. Server-side ONLY, never ship to the frontend.
SUPABASE_SERVICE_KEY=sb_secret_xxx

# Comma-separated origins allowed to call this API (your frontend URLs)
CORS_ORIGINS=http://localhost:5173

# AI reply suggestions (optional). Get a key at console.anthropic.com.
# Leave blank to turn the feature off cleanly.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
GROQ_API_KEY=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
GROQ_MODEL=openai/gpt-oss-20b
