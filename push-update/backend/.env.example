# Supabase → Project Settings → API Keys
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Publishable key (sb_publishable_...) — or legacy "anon" key. Low privilege.
SUPABASE_ANON_KEY=sb_publishable_xxx

# Secret key (sb_secret_...) — or legacy "service_role" key.
# Bypasses RLS. Server-side ONLY, never ship to the frontend.
SUPABASE_SERVICE_KEY=sb_secret_xxx

# Comma-separated origins allowed to call this API (your frontend URLs)
CORS_ORIGINS=http://localhost:5173

# AI reply suggestions (optional). Set ONE provider; leave both blank to disable.
# Groq — free, get a key at console.groq.com/keys :
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Anthropic (Claude) — alternative:
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Web Push notifications (optional). Generate keys once:
#   npx web-push generate-vapid-keys
# then paste them here. Leave blank to disable push.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
